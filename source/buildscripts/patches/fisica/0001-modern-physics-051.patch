+    void CharacterController::updateDeliriumBody(float duration)
+    {
+        MWBase::World* world = MWBase::Environment::get().getWorld();
+        CreatureStats& stats = mPtr.getClass().getCreatureStats(mPtr);
+        const std::string name(mPtr.getClass().getName(mPtr));
+        // A mod asks for an animation that goes over even a knockdown's (a surrender): on its feet, it has the body.
+        if (!mDelirium->isDown() && mAnimation->getLockedPlayPriority() > Priority_Knockdown)
+        {
+            deliriumEvent(name + ": cede el cuerpo a una animacion");
+            endDeliriumBody();
+            return;
+        }
+        mDelirium->step(duration);
+        if (mDelirium->isBroken())
+        {
+            deliriumEvent(name + ": el motor fallo (" + DeliriumBody::lastError() + ")");
+            endDeliriumBody();
+            return;
+        }
+        // An animation a mod started meanwhile would take the bones back.
+        if (mAnimation->hasActiveAnimations())
+            mAnimation->stopAllAnimations();
+        const std::vector<std::pair<std::string, osg::Matrixf>> poses = writeDeliriumBones();
+        if (deliriumConfig().mDebug && static_cast<int>(mDelirium->getAge() * 4) != static_cast<int>((mDelirium->getAge() - duration) * 4))
+            Log(Debug::Info) << "Delirium: " << name << " age " << mDelirium->getAge() << " pelvis "
+                             << mDelirium->getPelvisPosition() << " head " << mDelirium->getHeadHeight() << " down "
+                             << mDelirium->isDown() << " calm " << mDelirium->getCalmTime() << " still "
+                             << mDelirium->getStillTime();
+        if (mDelirium->isDown())
+        {
+            stats.setKnockedDown(true);
+            world->setActorCollisionMode(mPtr, true, false);
+            const bool knockout = stats.getFatigue().getCurrent() < 0 || stats.getFatigue().getBase() == 0;
+            if (knockout)
+                mDelirium->relax();
+            const float getUpTime = deliriumConfig().mGetUpTime;
+            const float downTime = mDelirium->getDownTime();
+            if (!knockout
+                && ((mDelirium->getStillTime() > 0.4f && downTime > getUpTime) || downTime > getUpTime + 5.f))
+            {
+                {
+            mDelirium.reset();
+            if (mAnimation != nullptr)
+                mAnimation->setPoseLocked(false, !mPtr.getClass().getCreatureStats(mPtr).isDead());
+        }
+                getUpFromRagdoll(poses);
+            }
+        }
+        else if (mDelirium->getCalmTime() > 0.2f || mDelirium->canLetGo() || mDelirium->getAge() > 15.f)
+        {
+            deliriumEvent(name + ": se recupera de pie");
+            endDeliriumBody();
+        }
+    }
+
+    void CharacterController::endDeliriumBody()
+    {
+        if (mDelirium == nullptr)
+            return;
+        MWBase::World* world = MWBase::Environment::get().getWorld();
+        const std::vector<std::pair<std::string, osg::Matrixf>> poses = mDelirium->getBonePoses();
+        const osg::Vec3f facing = mDelirium->getFacing();
+        const bool down = mDelirium->isDown();
+        {
+            mDelirium.reset();
+            if (mAnimation != nullptr)
+                mAnimation->setPoseLocked(false, !mPtr.getClass().getCreatureStats(mPtr).isDead());
+        }
+        world->setActorCollisionMode(mPtr, true, true);
+        if (down)
+        {
+            mPtr.getClass().getCreatureStats(mPtr).setKnockedDown(false);
+            return;
+        }
+        // Back to its animation from the pose it was left in, facing the way the body turned.
+        const ESM::Position& pos = mPtr.getRefData().getPosition();
+        world->rotateObject(mPtr, osg::Vec3f(pos.rot[0], pos.rot[1], std::atan2(facing.x(), facing.y())));
+        mAnimation->blendFromPose(poses, 0.4f);
+    }
