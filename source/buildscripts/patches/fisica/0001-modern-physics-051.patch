+
+        void gatherShape(const btCollisionShape* shape, const btTransform& toWorld, const btVector3& aabbMin,
+            const btVector3& aabbMax, std::vector<osg::Vec3f>& out, size_t maxTriangles)
+        {
+            if (shape == nullptr || out.size() >= maxTriangles * 3)
+                return;
+            if (shape->isCompound())
+            {
+                const auto* compound = static_cast<const btCompoundShape*>(shape);
+                for (int i = 0; i < compound->getNumChildShapes(); ++i)
+                    gatherShape(compound->getChildShape(i), toWorld * compound->getChildTransform(i), aabbMin, aabbMax,
+                        out, maxTriangles);
+                return;
+            }
+            btVector3 shapeMin, shapeMax;
+            shape->getAabb(toWorld, shapeMin, shapeMax);
+            if (shapeMin.x() > aabbMax.x() || shapeMax.x() < aabbMin.x() || shapeMin.y() > aabbMax.y()
+                || shapeMax.y() < aabbMin.y() || shapeMin.z() > aabbMax.z() || shapeMax.z() < aabbMin.z())
+                return;
+            if (shape->isConcave() && shape->getShapeType() != STATIC_PLANE_PROXYTYPE)
+            {
+                // The part of it inside the box, in its own space.
+                const btTransform toLocal = toWorld.inverse();
+                const btVector3 half = (aabbMax - aabbMin) * 0.5f;
+                const btVector3 center = toLocal * ((aabbMax + aabbMin) * 0.5f);
+                const btMatrix3x3 absolute = toLocal.getBasis().absolute();
+                const btVector3 extent(absolute[0].dot(half), absolute[1].dot(half), absolute[2].dot(half));
+                GatherTriangles gather;
+                gather.mToWorld = toWorld;
+                gather.mOut = &out;
+                gather.mMax = maxTriangles;
+                gather.mFaceUp = shape->getShapeType() == TERRAIN_SHAPE_PROXYTYPE;
+                static_cast<const btConcaveShape*>(shape)->processAllTriangles(&gather, center - extent, center + extent);
+                return;
+            }
+            if (!shape->isConvex())
+                return;
+            // Anything else: the box around it, in its own space.
+            btVector3 localMin, localMax;
+            shape->getAabb(btTransform::getIdentity(), localMin, localMax);
+            btVector3 corners[8];
+            for (int i = 0; i < 8; ++i)
+                corners[i] = toWorld
+                    * btVector3(i & 1 ? localMax.x() : localMin.x(), i & 2 ? localMax.y() : localMin.y(),
+                        i & 4 ? localMax.z() : localMin.z());
+            // outward faces
+            constexpr int faces[12][3] = { { 0, 2, 1 }, { 1, 2, 3 }, { 4, 5, 6 }, { 5, 7, 6 }, { 0, 1, 4 }, { 1, 5, 4 },
+                { 2, 6, 3 }, { 3, 6, 7 }, { 0, 4, 2 }, { 2, 4, 6 }, { 1, 3, 5 }, { 3, 7, 5 } };
+            for (const auto& face : faces)
+            {
+                if (out.size() + 3 > maxTriangles * 3)
+                    return;
+                for (int index : face)
+                    out.push_back(Misc::Convert::toOsg(corners[index]));
+            }
+        }
+    }
