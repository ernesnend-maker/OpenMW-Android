+    bool CharacterController::updateDelirium()
+    {
+        CreatureStats& stats = mPtr.getClass().getCreatureStats(mPtr);
+        DeliriumHit hit;
+        bool hasHit = stats.takeDeliriumHit(hit);
+        // Health lost some other way than Class::onHit (a mod that deals its own damage, say) is a hit too:
+        // a clear drop at once, not a slow drain. Away from whoever it fights, or the player if close.
+        const float health = stats.getHealth().getCurrent();
+        const float maxHealth = std::max(1.f, stats.getHealth().getModified());
+        if (!hasHit && deliriumConfig().mEnabled && mDeliriumHealth > 0 && health > 0
+            && mDeliriumHealth - health >= std::max(2.f, 0.04f * maxHealth))
+        {
+            hit.mStrength = (mDeliriumHealth - health) / maxHealth;
+            const osg::Vec3f position = mPtr.getRefData().getPosition().asVec3();
+            MWWorld::Ptr from;
+            if (stats.getAiSequence().isInCombat())
+                from = stats.getAiSequence().getActivePackage().getTarget();
+            if (from.isEmpty())
+            {
+                const MWWorld::Ptr player = getPlayer();
+                if ((player.getRefData().getPosition().asVec3() - position).length2() < 400.f * 400.f)
+                    from = player;
+            }
+            if (!from.isEmpty())
+            {
+                hit.mAway = position - from.getRefData().getPosition().asVec3();
+                hit.mAway.z() = 0;
+                if (hit.mAway.normalize() <= 0)
+                    hit.mAway = osg::Vec3f();
+            }
+            hasHit = true;
+            deliriumEvent(std::string(mPtr.getClass().getName(mPtr)) + ": pierde " + std::to_string(static_cast<int>(hit.mStrength * 100)) + "% de vida (sin golpe del motor)");
+        }
+        mDeliriumHealth = health;
+        const bool knockdown = stats.getKnockedDown();
+        const bool knockout = stats.getFatigue().getCurrent() < 0 || stats.getFatigue().getBase() == 0;
+        const bool alreadyDown = mHitState == CharState_KnockDown || mHitState == CharState_KnockOut
+            || mHitState == CharState_SwimKnockDown || mHitState == CharState_SwimKnockOut;
+        const DeliriumConfig& cfg = deliriumConfig();
+        const std::string name(mPtr.getClass().getName(mPtr));
+        if (mDelirium != nullptr || (cfg.mEnabled && cfg.mReal && canUseDeliriumBody()))
+        {
+            // The real engine: every blow goes to its body (made at the first one), which reacts by itself.
+            if (const char* reason = deliriumIneligibleReason())
+            {
+                if (mDelirium != nullptr)
+                    endDeliriumBody();
+                if (hasHit && cfg.mEnabled)
+                    deliriumEvent(name + ": nada (" + reason + ")");
+                return false;
+            }
+            const bool down = mDelirium != nullptr && mDelirium->isDown();
+            // (Once: the engine's knockdown stays on while it is down.)
+            const bool knocked = (knockdown || knockout) && !mDeliriumKnocked;
+            mDeliriumKnocked = knockdown || knockout;
+            bool fall = cfg.mKnockdowns && knocked && !alreadyDown && !down;
+            if (hasHit && cfg.mFallThreshold > 0 && hit.mStrength >= cfg.mFallThreshold)
+                fall = true;
+            if (!hasHit && !fall)
+                return mDelirium != nullptr;
+            if (mDelirium == nullptr && !fall && mAnimation->getHighestPlayingPriority() >= Priority_Storm)
+            {
+                // In the middle of something that goes over a hit (a mod's surrender): left alone, as the engine would.
+                deliriumEvent(name + ": nada (animacion prioritaria en curso)");
+                return false;
+            }
+            if (mDelirium == nullptr)
+            {
+                MWBase::World* world = MWBase::Environment::get().getWorld();
+                const char* blocked = world->isSwimming(mPtr) ? "nadando"
+                    : world->isFlying(mPtr) ? "volando"
+                    : alreadyDown ? "ya esta derribado"
+                    : nullptr;
+                if (blocked != nullptr)
+                {
+                    deliriumEvent(name + ": nada (" + blocked + ")");
+                    return false;
+                }
+                if (isScriptedAnimPlaying())
+                    mAnimQueue.clear();
+                if (!startDeliriumBody(false))
+                {
+                    deliriumEvent(name + ": el motor no pudo tomar el cuerpo (" + DeliriumBody::lastError() + ")");
+                    return false;
+                }
+            }
+            const osg::Vec3f position = mPtr.getRefData().getPosition().asVec3();
+            DeliriumBody::Blow blow;
+            blow.mDirection = hit.mPush.length2() > 0.01f ? hit.mPush : hit.mAway;
+            if (blow.mDirection.length2() < 0.01f && !hasHit)
+                blow.mDirection = osg::Quat(mPtr.getRefData().getPosition().rot[2], osg::Vec3f(0, 0, -1)) * osg::Vec3f(0, -1, 0);
+            if (hit.mPoint.length2() > 1.f)
+                blow.mPoint = hit.mPoint;
+            if (hit.mAway.length2() > 0.01f)
+                blow.mFrom = position - hit.mAway * 80.f + osg::Vec3f(0, 0, 110.f);
+            const float damage = hit.mStrength * maxHealth;
+            // A plain blow (15 points) pushes 100 N s; twice the damage, 2^0.8 times as hard.
+            float limit = 240.f;
+            if (!hasHit)
+                blow.mPush = 130.f;
+            else if (cfg.mByStrength)
+            {
+                // ...and with the option, as far as the damage and the attacker's strength (50: plain) go.
+                blow.mPush = 100.f * std::pow(std::clamp(damage / 15.f, 0.2f, 8.f), 0.8f)
+                    * std::pow(std::clamp(hit.mAttackerStrength / 50.f, 0.3f, 6.f), 0.8f);
+                limit = 450.f;
+            }
+            else
+                blow.mPush = 100.f * std::clamp(std::pow(std::max(damage, 0.f) / 15.f, 0.8f), 0.4f, 3.f);
+            blow.mPush *= cfg.mPush;
+            limit *= std::max(1.f, cfg.mPush);
+            if (hasHit && cfg.mMonsters && hit.mAttackerMonster)
+            {
+                blow.mPush *= cfg.mMonsterPower;
+                limit = std::max(limit, 250.f * cfg.mMonsterPower);
+                if (cfg.mMonsterPower >= 2.f)
+                    fall = true;
+            }
+            blow.mMaxPush = std::min(limit, 1200.f);
+            blow.mHealth = health / maxHealth;
+            blow.mFall = fall;
+            if (const char* test = std::getenv("FISICA_ELEM")) // (test bench: every blow is a spell of this element)
+            {
+                hit.mMagic = true;
+                hit.mElement = std::atoi(test);
+            }
+            blow.mGuard = cfg.mGuard && !hit.mMagic;
+            if (hit.mMagic && hit.mElement != 0)
+            {
+                blow.mElement = hit.mElement;
+                blow.mElementTime = std::clamp(1.2f + hit.mStrength * 6.f, 1.2f, 4.f);
+            }
+            deliriumEvent(name + ": " + mDelirium->hit(blow));
+            if (cfg.mReplaceHits || fall)
+                stats.setHitRecovery(false);
+            if (!fall)
+                stats.setKnockedDown(false);
+            return true;
+        }
+        if (!hasHit && !((knockdown || knockout) && !alreadyDown))
+            return false;
+        if (const char* reason = deliriumIneligibleReason())
+        {
+            if (hasHit && cfg.mEnabled)
+                deliriumEvent(name + ": nada (" + reason + ")");
+            return false;
+        }
+        bool fall = cfg.mKnockdowns && (knockdown || knockout) && !alreadyDown;
+        if (hasHit && !fall && cfg.mFallThreshold > 0)
+        {
+            fall = hit.mStrength >= cfg.mFallThreshold;
+        }
+        if (fall && !alreadyDown)
+        {
+            if (const char* reason = fallBlockedReason())
+                deliriumEvent(name + ": no cae (" + reason + ")");
+            else
+            {
+                const float* tune = cfg.mTune;
+                osg::Vec3f kick = hit.mAway * std::min(tune[0] + tune[1] * hit.mStrength, tune[2]);
+                kick.z() = tune[3];
+                if (isScriptedAnimPlaying())
+                    mAnimQueue.clear(); // its scripted animations end with the fall
+                if (startLiveRagdoll(kick))
+                {
+                    deliriumEvent(name + ": CAE con fisica");
+                    return true;
+                }
+                deliriumEvent(name + ": no cae (no se pudo crear el ragdoll)");
+            }
+        }
+        if (hasHit)
+        {
+            osg::Vec3f away = hit.mAway;
+            if (away.length2() < 0.01f)
+                away = osg::Quat(mPtr.getRefData().getPosition().rot[2], osg::Vec3f(0, 0, -1)) * osg::Vec3f(0, -1, 0);
+            const osg::Vec3f local = osg::Quat(mPtr.getRefData().getPosition().rot[2], osg::Vec3f(0, 0, 1)) * away;
+            const float speed = (cfg.mTune[15] + cfg.mTune[16] * std::min(hit.mStrength, 0.5f)) * cfg.mIntensity;
+            mFlinchSpeed += osg::Vec2f(local.x(), local.y()) * speed;
+            mFlinching = true;
+            if (cfg.mReplaceHits && stats.getHitRecovery() && !knockdown && !knockout)
+                stats.setHitRecovery(false);
+            deliriumEvent(name + ": se dobla" + (fall ? "" : " (golpe leve)"));
+        }
+        return false;
+    }
