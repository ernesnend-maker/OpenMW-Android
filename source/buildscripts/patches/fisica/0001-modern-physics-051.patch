+        mPoseBlendPoses.clear();
+    }
+
+    void Animation::addPoseBlendControllers()
+    {
+        if (mPoseBlend == nullptr)
+            return;
+        auto* state = static_cast<PoseBlendState*>(mPoseBlend.get());
+        bool first = true;
+        for (const auto& [bone, pose] : mPoseBlendPoses)
+        {
+            const auto found = getNodeMap().find(bone);
+            if (found == getNodeMap().end())
+                continue;
+            osg::ref_ptr<osg::Callback> controller
+                = new PoseBlendController(state, pose, first ? mInsert.get() : nullptr);
+            first = false;
+            found->second->addUpdateCallback(controller);
+            mActiveControllers.emplace_back(found->second, controller);
+        }
