+    std::vector<osg::Vec3f> PhysicsSystem::getStaticTriangles(
+        const osg::Vec3f& center, float radius, float height, size_t maxTriangles) const
+    {
+        const btVector3 bulletCenter = Misc::Convert::toBullet(center);
+        const btVector3 aabbMin = bulletCenter - btVector3(radius, radius, height);
+        const btVector3 aabbMax = bulletCenter + btVector3(radius, radius, height);
+        StaticObjectsCallback callback;
+        mTaskScheduler->aabbTest(aabbMin, aabbMax, callback);
+        std::vector<osg::Vec3f> triangles;
+        for (const btCollisionObject* object : callback.mObjects)
+            gatherShape(object->getCollisionShape(), object->getWorldTransform(), aabbMin, aabbMax, triangles,
+                maxTriangles);
+        return triangles;
+    }
