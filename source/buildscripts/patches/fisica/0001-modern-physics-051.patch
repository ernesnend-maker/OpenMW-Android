+    void DeliriumBody::message(const char* name, bool start)
+    {
+        nm_msg_begin(mAgent, name);
+        if (start)
+            nm_msg_set_bool(mAgent, "start", 1);
+        nm_msg_send(mAgent, mWorld);
+    }
