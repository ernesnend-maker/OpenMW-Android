+    void Animation::setFlinch(const osg::Quat& rotation, float lower, float upper, float neck, float arms)
+    {
+        // Each takes its share of the angle (negative: the other way, as the arms, left behind by the body).
+        double angle = 0;
+        osg::Vec3d axis;
+        rotation.getRotate(angle, axis);
+        const std::pair<RotateController*, float> parts[]
+            = { { mFlinchLower.get(), lower }, { mFlinchUpper.get(), upper }, { mFlinchNeck.get(), neck },
+                  { mFlinchArmL.get(), arms }, { mFlinchArmR.get(), arms } };
+        for (const auto& [controller, share] : parts)
+        {
+            if (controller == nullptr)
+                continue;
+            controller->setRotate(angle == 0 ? osg::Quat() : osg::Quat(angle * share, axis));
+        }
+    }
