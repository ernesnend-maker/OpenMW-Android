new file mode 100644
index 000000000..759a3caee
--- /dev/null
+++ b/apps/openmw/mwmechanics/deliriumbody.hpp
@@ -0,0 +1,154 @@
+#ifndef OPENMW_MWMECHANICS_DELIRIUMBODY_H
+#define OPENMW_MWMECHANICS_DELIRIUMBODY_H
+
+#include <array>
+#include <functional>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include <osg/Matrixf>
+#include <osg/Vec3f>
+
+struct NmAgent;
+struct NmWorld;
+
+namespace MWMechanics
+{
+    // Fisica: the real Delirium engine (PVCPC/delirium-physics, GPL-3: the behaviours of GTA IV's Euphoria,
+    // rewritten) driving one actor's body, as Skyrim Delirium does it: the body is Delirium's own (21 parts with
+    // muscles, in a little world of its own: the ground and what is around), started from the pose the animation
+    // left, and the bones are put where its parts are. It balances, takes a step to catch a blow, flinches, falls,
+    // breaks the fall, writhes, dies.
+    class DeliriumBody
+    {
+    public:
+        using Poses = std::vector<std::pair<std::string, osg::Matrixf>>;
+        using BoneGetter = std::function<std::optional<osg::Matrixf>(std::string_view)>;
+
+        /// Whether the engine was built in (and its character loads).
+        static bool available();
+        static const std::string& lastError();
+
+        /// @param bone world matrices of the skeleton's bones (game units)
+        /// @param base the actor's base node (its position, heading and size)
+        /// @param heading the actor's (radians, 0: +Y, clockwise)
+        /// @param beast a beast race's skeleton (its own body: the legs)
+        /// @param dying it starts as its death (no balance)
+        /// @return null if this skeleton doesn't have the bones
+        static std::unique_ptr<DeliriumBody> create(
+            const BoneGetter& bone, const osg::Matrixf& base, const osg::Vec3f& position, float heading, bool beast,
+            bool dying);
+        ~DeliriumBody();
+
+        /// World triangles around it (game units, 3 vertices each); without any: a flat floor at its feet.
+        void setWorld(const std::vector<osg::Vec3f>& triangles);
+        /// Where it was made (the middle of its world).
+        const osg::Vec3f& getOrigin() const { return mOrigin; }
+
+        void step(float duration);
+
+        /// The bones' world matrices (game units), parents first; the pelvis is the first.
+        Poses getBonePoses() const;
+        osg::Vec3f getPelvisPosition() const;
+        /// The way it faces (flat, unit), from its hips.
+        osg::Vec3f getFacing() const;
+        float getHeadHeight() const; // game units over where it stood
+
+        struct Blow
+        {
+            std::optional<osg::Vec3f> mPoint; // where it landed (world), else the chest
+            osg::Vec3f mDirection; // the way it pushes (unit; zero: none)
+            float mPush = 0; // N s
+            float mMaxPush = 240; // N s
+            float mHealth = 1; // what is left of its health (0-1)
+            bool mFall = false; // it must go down
+            bool mGuard = false; // a light one: the flinch with the hands up
+            int mElement = 0; // a spell's: 1 fire (it thrashes), 2 lightning (it convulses), 3 frost (it curls up, shivering)
+            float mElementTime = 0; // seconds of it
+            std::optional<osg::Vec3f> mFrom; // whoever did it (world), to look at
+        };
+        /// @return what it does (for the diagnostics)
+        std::string hit(const Blow& blow);
+        /// It died: the killing blow as Delirium plays it, then limp.
+        void die(const osg::Vec3f& direction);
+
+        bool isDown() const { return mDown; }
+        bool isDying() const { return mDying; }
+        float getDownTime() const { return mDown ? mAge - mDownAt : 0.f; }
+        /// On its feet again and steady for this long (seconds).
+        float getCalmTime() const { return mCalm; }
+        /// On its feet and holding, long enough after the last blow for its size: the animation (and whoever drives
+        /// the actor: its AI, a mod's) can have it back, as after the engine's own hit animation.
+        bool canLetGo() const { return mCanLetGo; }
+        /// Lying still for this long (seconds).
+        float getStillTime() const { return mStill; }
+        float getAge() const { return mAge; }
+        /// Something went wrong inside (not a number): it must be let go.
+        bool isBroken() const { return mBroken; }
+        /// Limp (knocked out): no getting up by itself.
+        void relax();
+
+    private:
+        DeliriumBody() = default;
+
+        struct V3
+        {
+            float x = 0, y = 0, z = 0;
+        };
+        struct Q
+        {
+            float x = 0, y = 0, z = 0, w = 1;
+        };
+        friend struct DeliriumMath;
+
+        void message(const char* name, bool start = true);
+        void partsFromBones(const BoneGetter& bone, std::array<V3, 21>& pos, std::array<Q, 21>& rot) const;
+        V3 toPhysics(const osg::Vec3f& world) const;
+        osg::Vec3f toWorld(const V3& physics) const;
+        void push(const V3& at, const V3& direction, float impulse);
+
+        NmAgent* mAgent = nullptr;
+        NmWorld* mWorld = nullptr;
+        osg::Vec3f mOrigin; // game units; the physics works in metres from here
+        osg::Matrixf mSize; // rigid (the body's) -> drawn (the actor's size, about where it stood)
+        osg::Matrixf mSizeInverse;
+        // The written bones: each one's place in its parent bone (parents first), from the skeleton as it was taken.
+        struct Bone
+        {
+            std::string mName;
+            int mPart; // the part whose turn it takes
+            int mParent; // index here, -1: the pelvis
+            V3 mInParent;
+        };
+        std::vector<Bone> mBones;
+        std::array<Q, 21> mRestRot;
+        std::array<V3, 21> mRestPos;
+        float mAge = 0;
+        float mSincePush = 10;
+        float mCalm = 0;
+        float mStill = 0;
+        float mOffBalance = 0;
+        bool mWasBalancing = false;
+        bool mDown = false;
+        float mDownAt = 0;
+        bool mDying = false;
+        bool mLimp = false;
+        float mRelaxAt = -1;
+        float mWritheFor = 0;
+        float mWritheUntil = -1;
+        bool mBroken = false;
+        bool mCanLetGo = false;
+        void startElement(int element, float seconds, const V3& away);
+        void stopElement();
+        int mElement = 0;
+        float mElementUntil = -1;
+        float mHold = 0.5f; // seconds a blow keeps the body (by its push)
+        bool mBeast = false;
+    };
+}
+
+#endif
