+                continue;
+            btRigidBody& body = *strike.mObject->getRigidBody();
+            body.activate(true);
+            body.applyImpulse(
+                strike.mVelocityChange / body.getInvMass(), strike.mPoint - body.getCenterOfMassPosition());
