+    void DeliriumBody::step(float duration)
+    {
+        const float dt = std::clamp(duration, 0.f, 0.1f);
+        if (dt <= 0 || mBroken)
+            return;
+        mAge += dt;
+        mSincePush += dt;
+        const int steps = std::clamp(static_cast<int>(std::ceil(dt / sStep - 0.05f)), 1, 6);
+        for (int n = 0; n < steps; ++n)
+            if (nm_agent_step(mAgent, mWorld, dt / steps) < 0)
+            {
+                sError = "step: " + engineError();
+                mBroken = true;
+                return;
+            }
+        float head[3] = {}, q[4] = {};
+        nm_agent_get_part_transform(mAgent, sHead, head, q);
+        float pelvis[3] = {};
+        nm_agent_get_part_transform(mAgent, 0, pelvis, q);
+        if (pelvis[2] < -8.f)
+        {
+            sError = "fell out of its world";
+            mBroken = true;
+            return;
+        }
+        if (!finite(head, 3) || !finite(pelvis, 3) || !finite(q, 4))
+        {
+            sError = "not a number";
+            mBroken = true;
+            return;
+        }
+
+        const bool fallen = nm_agent_has_fallen(mAgent) != 0;
+        const bool balancing = nm_agent_is_balancing(mAgent) != 0;
+        const float energy = nm_agent_get_kinetic_energy(mAgent);
+        mOffBalance = mWasBalancing && !balancing ? mOffBalance + dt : 0.f;
+        mWasBalancing = mWasBalancing || balancing;
+        // Down: Delirium says so (or its balance is gone) and the head is on its way to the ground.
+        if (!mDown && (fallen || mOffBalance > 0.25f || mDying) && head[2] - pelvis[2] < 0.35f && head[2] < 1.0f)
+        {
+            mDown = true;
+            mDownAt = mAge;
+            if (!mDying && mWritheFor > 0)
+                mWritheUntil = -2; // starts once it has broken the fall
+        }
+        if (mDown && !mDying && !mLimp)
+        {
+            if (mWritheUntil == -2 && mAge - mDownAt > 0.7f)
+            {
+                // Hurt, on the ground: it writhes a while.
+                message("stopAllBehaviours", false);
+                const float stiffness = random(9.f, 12.f), period = random(2.f, 4.f), amplitude = random(0.7f, 1.3f);
+                nm_msg_begin(mAgent, "bodyWrithe");
+                nm_msg_set_bool(mAgent, "start", 1);
+                for (const char* n : { "armStiffness", "legStiffness", "backStiffness" })
+                    nm_msg_set_float(mAgent, n, stiffness);
+                for (const char* n : { "armPeriod", "legPeriod", "backPeriod" })
+                    nm_msg_set_float(mAgent, n, period * random(0.8f, 1.2f));
+                for (const char* n : { "armAmplitude", "legAmplitude", "backAmplitude", "kneeAmplitude", "elbowAmplitude" })
+                    nm_msg_set_float(mAgent, n, amplitude * random(0.8f, 1.2f));
+                for (const char* n : { "armDamping", "legDamping", "backDamping" })
+                    nm_msg_set_float(mAgent, n, 1.f);
+                nm_msg_send(mAgent, mWorld);
+                mWritheUntil = mAge + mWritheFor;
+            }
+            else if (mWritheUntil >= 0 && mAge >= mWritheUntil)
+            {
+                mWritheUntil = -1;
+                message("stopAllBehaviours", false);
+                nm_msg_begin(mAgent, "bodyRelax");
+                nm_msg_set_bool(mAgent, "start", 1);
+                nm_msg_set_float(mAgent, "relaxation", 60.f);
+                nm_msg_set_float(mAgent, "damping", 1.f);
+                nm_msg_send(mAgent, mWorld);
+            }
+        }
+        if (mDying && !mLimp && mRelaxAt >= 0 && mAge >= mRelaxAt)
+        {
+            mLimp = true;
+            message("stopAllBehaviours", false);
+            nm_msg_begin(mAgent, "bodyRelax");
+            nm_msg_set_bool(mAgent, "start", 1);
+            nm_msg_set_float(mAgent, "relaxation", random(60.f, 100.f));
+            nm_msg_set_float(mAgent, "damping", 1.f);
+            nm_msg_send(mAgent, mWorld);
+        }
+        if (mElement != 0 && mAge >= mElementUntil)
+            stopElement();
+        const bool writhing = mWritheUntil >= 0 || mWritheUntil == -2;
+        mCalm = (!mDown && balancing && !fallen && energy < 4.f && mSincePush > 0.35f) ? mCalm + dt : 0.f;
+        if (mElement != 0)
+            mCalm = 0;
+        mCanLetGo = mElement == 0 && !mDown && !mDying && balancing && !fallen && mSincePush > mHold && head[2] > 1.25f
+            && head[2] - pelvis[2] > 0.45f;
+        mStill = (mDown && energy < 1.5f && !writhing) ? mStill + dt : 0.f;
+    }
+
+    DeliriumBody::Poses DeliriumBody::getBonePoses() const
+    {
+        sRig = mBeast ? kRigBeast : kRig;
+        Poses poses;
+        poses.reserve(mBones.size());
+        std::vector<V3> places(mBones.size());
+        std::vector<Q> turns(mBones.size());
+        for (size_t i = 0; i < mBones.size(); ++i)
+        {
+            const Bone& bone = mBones[i];
+            float p[3] = {}, q[4] = { 0, 0, 0, 1 };
+            nm_agent_get_part_transform(mAgent, bone.mPart, p, q);
+            const Q part{ q[0], q[1], q[2], q[3] };
+            turns[i] = M::norm(M::mul(part, offsetOf(bone.mPart)));
+            if (bone.mParent < 0)
+                places[i] = M::add({ p[0], p[1], p[2] }, M::rot(part, anchorOf(bone.mPart)));
+            else
+                places[i] = M::add(places[bone.mParent], M::rot(turns[bone.mParent], bone.mInParent));
+            osg::Matrixf rigid;
+            rigid.makeRotate(osg::Quat(turns[i].x, turns[i].y, turns[i].z, turns[i].w));
+            rigid.setTrans(osg::Vec3f(places[i].x, places[i].y, places[i].z) / sUnit + mOrigin);
+            poses.emplace_back(bone.mName, rigid * mSize);
+        }
+        return poses;
+    }
+
+    osg::Vec3f DeliriumBody::getPelvisPosition() const
+    {
+        float p[3] = {}, q[4] = { 0, 0, 0, 1 };
+        nm_agent_get_part_transform(mAgent, 0, p, q);
+        return toWorld({ p[0], p[1], p[2] });
+    }
+
+    osg::Vec3f DeliriumBody::getFacing() const
+    {
+        float l[3] = {}, r[3] = {}, q[4] = {};
+        nm_agent_get_part_transform(mAgent, 1, l, q);
+        nm_agent_get_part_transform(mAgent, 4, r, q);
+        // left x up
+        osg::Vec3f facing(l[1] - r[1], -(l[0] - r[0]), 0.f);
+        if (facing.normalize() <= 0)
+            return osg::Vec3f(0, 1, 0);
+        return facing;
+    }
+
+    float DeliriumBody::getHeadHeight() const
+    {
+        float p[3] = {}, q[4] = {};
+        nm_agent_get_part_transform(mAgent, sHead, p, q);
+        return p[2] / sUnit;
+    }
+
+    void DeliriumBody::push(const V3& at, const V3& direction, float impulse)
+    {
+        if (impulse <= 0)
+            return;
+        const float p[3] = { at.x, at.y, at.z };
+        const float i[3] = { direction.x * impulse, direction.y * impulse, direction.z * impulse };
+        nm_agent_apply_push(mAgent, p, i);
+        mHold = std::clamp(0.4f + impulse / 220.f, 0.5f, 1.8f);
+        mSincePush = 0;
+        mCalm = 0;
+        mStill = 0;
+    }
+
+    std::string DeliriumBody::hit(const Blow& blow)
+    {
+        // As Skyrim Delirium's reaction table for a weapon's blow: a light one flinches (guard up, turned to whoever
+        // did it), a harder one is GTA's shot reaction (wounded where it landed, fighting to stay on its feet,
+        // steps to catch itself), and past what the steps can catch it falls. On the ground it only takes the push.
+        constexpr float flinchBelow = 40.f, plainPush = 45.f;
+        float at[3] = {}, q[4] = {};
+        int part = sChest;
+        if (blow.mPoint)
+        {
+            const V3 p = toPhysics(*blow.mPoint);
+            at[0] = p.x, at[1] = p.y, at[2] = p.z;
+            part = std::max(0, nm_agent_nearest_part(mAgent, at));
+        }
+        // (The point Morrowind gives is on the actor's box, not its body: the part's own middle, at that height.)
+        {
+            float pp[3] = {};
+            nm_agent_get_part_transform(mAgent, part, pp, q);
+            at[0] = pp[0], at[1] = pp[1], at[2] = pp[2];
+        }
+        const V3 direction{ blow.mDirection.x(), blow.mDirection.y(), blow.mDirection.z() };
+        const bool pushes = M::len(direction) > 0.5f;
+        const float want = std::min(blow.mPush, blow.mMaxPush);
+        if (mDown || mDying)
+        {
+            if (pushes)
+                push({ at[0], at[1], at[2] }, direction, want * 0.6f);
+            return "en el suelo: solo el empujon";
+        }
+        float look[3] = {};
+        const bool sees = blow.mFrom.has_value();
+        if (sees)
+        {
+            const V3 from = toPhysics(*blow.mFrom);
+            look[0] = from.x, look[1] = from.y, look[2] = from.z;
+        }
+        const float oomph = std::clamp((blow.mPush / plainPush - 1.3f) / (4.f - 1.3f), 0.f, 1.f);
+        std::string how;
+        int result = 0;
+        if (!blow.mFall && blow.mPush < flinchBelow)
+        {
+            if (sees && blow.mGuard)
+            {
+                result = nm_agent_task_flinch(mAgent, mWorld, nullptr, look);
+                how = "se encoge (flinch)";
+            }
+            else
+            {
+                result = nm_agent_task_balance(mAgent, mWorld, nullptr, nullptr);
+                how = "aguanta el golpe";
+            }
+        }
+        else
+        {
+            // GTA's health scale: 100 and up stays on its feet and catches a fall, under 100 is hurt and falls.
+            const float share = std::clamp(blow.mHealth, 0.f, 1.f);
+            float health = share >= 0.2f ? 100.f + 100.f * share : 50.f + 49.f * share / 0.2f;
+            if (blow.mFall)
+                health = std::min(health, 60.f);
+            const float d[3] = { direction.x, direction.y, direction.z };
+            result = nm_agent_task_shot(mAgent, mWorld, "MELEE", part, at, d, health);
+            how = blow.mFall ? "herido, cae (shot)" : "herido, aguanta de pie (shot)";
+            if (result >= 0 && oomph > 0)
+            {
+                // A harder hit jolts harder: the shot twists the spine on impact.
+                const float k = 1.f + 2.f * oomph;
+                nm_msg_begin(mAgent, "shot");
+                nm_msg_set_bool(mAgent, "alwaysAddShockSpin", 1);
+                nm_msg_set_float(mAgent, "shockSpinMin", 40.f * k);
+                nm_msg_set_float(mAgent, "shockSpinMax", 80.f * k);
+                nm_msg_send(mAgent, mWorld);
+                if (pushes)
+                {
+                    // ...and the head snaps with it.
+                    float hp[3] = {};
+                    nm_agent_get_part_transform(mAgent, sHead, hp, q);
+                    push({ hp[0], hp[1], hp[2] }, direction, 0.2f * want * (0.5f + oomph));
+                }
+            }
+            mWritheFor = std::max(mWritheFor, 0.5f * (1.f + 1.2f * oomph));
+        }
+        if (blow.mElement != 0 && blow.mElementTime > 0)
+        {
+            startElement(blow.mElement, blow.mElementTime, direction);
+            how += blow.mElement == 1 ? ", ARDE" : blow.mElement == 2 ? ", ELECTROCUTADO" : ", CONGELADO";
+        }
+        if (result < 0)
+            how += " [error: " + engineError() + "]";
+        if (pushes)
+            push({ at[0], at[1], at[2] }, direction, want);
+        mSincePush = 0;
+        mCalm = 0;
+        return how + ", empujon " + std::to_string(static_cast<int>(want)) + " N s";
+    }
+
+    void DeliriumBody::startElement(int element, float seconds, const V3& away)
+    {
+        // As Skyrim Delirium's: burning it thrashes its arms and back and leans away; lightning convulses it; frost
+        // curls its upper body up, shivering, with short careful steps.
+        if (mElement != 0 && mElement != element)
+            stopElement();
+        mElementUntil = std::max(mElementUntil, mAge + seconds);
+        if (mElement == element)
+            return;
+        mElement = element;
+        if (element == 1)
+        {
+            nm_msg_begin(mAgent, "bodyWrithe");
+            nm_msg_set_bool(mAgent, "start", 1);
+            nm_msg_set_string(mAgent, "mask", "ub");
+            nm_msg_set_float(mAgent, "armStiffness", 12.f);
+            nm_msg_set_float(mAgent, "armDamping", 0.5f);
+            nm_msg_set_float(mAgent, "armPeriod", random(0.4f, 0.6f));
+            nm_msg_set_float(mAgent, "armAmplitude", random(1.5f, 2.f));
+            nm_msg_set_float(mAgent, "elbowAmplitude", 1.5f);
+            nm_msg_set_float(mAgent, "backStiffness", 11.f);
+            nm_msg_set_float(mAgent, "backDamping", 0.6f);
+            nm_msg_set_float(mAgent, "backPeriod", random(0.8f, 1.2f));
+            nm_msg_set_float(mAgent, "backAmplitude", random(0.8f, 1.2f));
+            nm_msg_send(mAgent, mWorld);
+            if (M::len(away) > 0.5f)
+            {
+                const float v[3] = { away.x, away.y, 0.f };
+                nm_msg_begin(mAgent, "leanInDirection");
+                nm_msg_set_bool(mAgent, "start", 1);
+                nm_msg_set_bool(mAgent, "applyAsForce", 0);
+                nm_msg_set_vec3(mAgent, "dir", v);
+                nm_msg_set_float(mAgent, "leanAmount", random(0.2f, 0.35f));
+                nm_msg_send(mAgent, mWorld);
+            }
+        }
+        else if (element == 2)
+        {
+            nm_msg_begin(mAgent, "electrocute");
+            nm_msg_set_bool(mAgent, "start", 1);
+            nm_msg_set_float(mAgent, "stunMag", random(0.45f, 0.55f));
+            nm_msg_set_float(mAgent, "stunInterval", 0.07f);
+            nm_msg_set_float(mAgent, "largeMult", 3.f);
+            nm_msg_set_float(mAgent, "largeMinTime", 0.2f);
+            nm_msg_set_float(mAgent, "largeMaxTime", 0.45f);
+            nm_msg_set_float(mAgent, "directionRandomness", 0.6f);
+            nm_msg_send(mAgent, mWorld);
+        }
+        else if (element == 3)
+        {
+            nm_msg_begin(mAgent, "bodyFoetal");
+            nm_msg_set_bool(mAgent, "start", 1);
+            nm_msg_set_string(mAgent, "mask", "ub");
+            nm_msg_set_float(mAgent, "stiffness", 7.f);
+            nm_msg_set_float(mAgent, "dampingFactor", 1.6f);
+            nm_msg_set_float(mAgent, "asymmetry", 0.3f);
+            nm_msg_set_int(mAgent, "randomSeed", static_cast<int>(random(1.f, 10000.f)));
+            nm_msg_send(mAgent, mWorld);
+            nm_msg_begin(mAgent, "electrocute");
+            nm_msg_set_bool(mAgent, "start", 1);
+            nm_msg_set_bool(mAgent, "leftLeg", 0);
+            nm_msg_set_bool(mAgent, "rightLeg", 0);
+            nm_msg_set_float(mAgent, "stunMag", 0.06f);
+            nm_msg_set_float(mAgent, "stunInterval", 0.05f);
+            nm_msg_set_float(mAgent, "largeMult", 1.f);
+            nm_msg_set_float(mAgent, "directionRandomness", 0.3f);
+            nm_msg_send(mAgent, mWorld);
+        }
+    }
+
+    void DeliriumBody::stopElement()
+    {
+        const char* const messages[][2] = { { nullptr, nullptr }, { "bodyWrithe", "leanInDirection" },
+            { "electrocute", nullptr }, { "bodyFoetal", "electrocute" } };
+        if (mElement >= 1 && mElement <= 3)
+            for (const char* name : messages[mElement])
+                if (name != nullptr)
+                    message(name, false);
+        mElement = 0;
+        mElementUntil = -1;
+    }
+
+    void DeliriumBody::die(const osg::Vec3f& away)
+    {
+        if (mDying)
+            return;
+        if (mElement != 0)
+            stopElement();
+        mDying = true;
+        mWritheUntil = -1;
+        // The killing blow as a shot at little health: Delirium's own hit reaction (stagger, clutch, collapse), on
+        // the upper body, away from the killer (up to 25 degrees either way, so every body doesn't fall the same).
+        message("stopAllBehaviours", false);
+        constexpr int parts[] = { 8, 9, 10, 11, 13, 17 };
+        const int part = parts[Misc::Rng::rollDice(6)];
+        float at[3] = {}, q[4] = {};
+        nm_agent_get_part_transform(mAgent, part, at, q);
+        V3 direction{ away.x(), away.y(), 0.f };
+        if (M::len(direction) > 0.5f)
+        {
+            const float t = random(-0.44f, 0.44f), cs = std::cos(t), sn = std::sin(t);
+            direction = { direction.x * cs - direction.y * sn, direction.x * sn + direction.y * cs, 0.f };
+            direction = M::scl(direction, 1.f / M::len(direction));
+        }
+        else
+            direction = {};
+        const float d[3] = { direction.x, direction.y, direction.z };
+        nm_agent_task_shot(mAgent, mWorld, nullptr, part, at, d, 70.f);
+        if (M::len(direction) > 0.5f)
+            push({ at[0], at[1], at[2] }, direction, 0.5f * nm_agent_get_mass(mAgent) * 1.5f * random(0.8f, 1.2f));
+        mRelaxAt = mAge + random(1.8f, 3.f);
+    }
+
+    void DeliriumBody::relax()
+    {
+        if (mLimp)
+            return;
+        mLimp = true;
+        mWritheUntil = -1;
+        message("stopAllBehaviours", false);
+        nm_msg_begin(mAgent, "bodyRelax");
+        nm_msg_set_bool(mAgent, "start", 1);
+        nm_msg_set_float(mAgent, "relaxation", 80.f);
+        nm_msg_set_float(mAgent, "damping", 1.f);
+        nm_msg_send(mAgent, mWorld);
+    }
+#endif
+}
