+    void DeliriumBody::setWorld(const std::vector<osg::Vec3f>& triangles)
+    {
+        const bool bothWays = std::getenv("FISICA_BOTH") != nullptr;
+        if (triangles.size() < 3)
+            return;
+        NmWorld* world = nm_world_create();
+        if (world == nullptr)
+            return;
+        std::vector<float> positions;
+        std::vector<uint32_t> indices;
+        positions.reserve(triangles.size() * 3);
+        indices.reserve(triangles.size());
+        for (const osg::Vec3f& vertex : triangles)
+        {
+            const V3 p = toPhysics(vertex);
+            indices.push_back(static_cast<uint32_t>(positions.size() / 3));
+            positions.insert(positions.end(), { p.x, p.y, p.z });
+        }
+        // Morrowind's collision meshes face any way; Delirium's world wants them facing out: both ways.
+        if (bothWays)
+        {
+            const size_t count = indices.size();
+            for (size_t i = 0; i + 2 < count; i += 3)
+                indices.insert(indices.end(), { indices[i], indices[i + 2], indices[i + 1] });
+        }
+        if (nm_world_add_mesh(world, positions.data(), static_cast<int32_t>(positions.size() / 3), indices.data(),
+                static_cast<int32_t>(indices.size() / 3), nullptr)
+            < 0)
+        {
+            sError = "world: " + engineError();
+            nm_world_destroy(world);
+            return;
+        }
+        // No ground under it there (a hole in what was gathered): the flat floor stays as well.
+        const V3 pelvis = toPhysics(getPelvisPosition());
+        const float from[3] = { pelvis.x, pelvis.y, pelvis.z }, down[3] = { 0, 0, -1 };
+        float distance = 0, normal[3] = {};
+        const int found = nm_world_raycast(world, from, down, 3.f, &distance, normal);
+        Log(Debug::Verbose) << "Delirium: ground " << distance << " m under the pelvis (" << pelvis.z
+                            << " m over its feet), facing " << normal[2] << (found > 0 ? "" : " (none)");
+        if (found <= 0)
+            nm_world_add_floor(world, 0, 0, 0, 100.f);
+        nm_world_destroy(mWorld);
+        mWorld = world;
+    }
