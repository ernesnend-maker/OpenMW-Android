+    void DeliriumBody::partsFromBones(const BoneGetter& bone, std::array<V3, 21>& pos, std::array<Q, 21>& rot) const
+    {
+        // Parts from the bones as the animation posed them: turns through the rig, places down the chain from the
+        // pelvis (as Skyrim Delirium's PartsFromBones).
+        for (int i = 0; i < 21; ++i)
+        {
+            const osg::Matrixf rigid = *bone(sRig[i].mBone) * mSizeInverse;
+            rot[i] = M::norm(M::mul(rotationOf(rigid), M::conj(offsetOf(i))));
+            if (i == 0)
+            {
+                const osg::Vec3f at = rigid.getTrans() - mOrigin;
+                pos[0] = M::sub({ at.x() * sUnit, at.y() * sUnit, at.z() * sUnit }, M::rot(rot[0], anchorOf(0)));
+            }
+            else
+            {
+                const int p = sParent[i];
+                pos[i] = M::sub(M::add(pos[p], M::rot(rot[p], inParentOf(i))), M::rot(rot[i], anchorOf(i)));
+            }
+        }
+    }
