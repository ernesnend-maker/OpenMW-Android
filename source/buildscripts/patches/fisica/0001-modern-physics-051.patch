+    void CharacterController::updateLiveRagdoll(float duration)
+    {
+        MWBase::World* world = MWBase::Environment::get().getWorld();
+        const std::vector<std::pair<std::string, osg::Matrixf>> poses = world->getRagdollBonePoses(mPtr);
+        CreatureStats& stats = mPtr.getClass().getCreatureStats(mPtr);
+        if (poses.empty())
+        {
+            // Gone (it came apart): the knockdown animation takes over.
+            deliriumEvent(std::string(mPtr.getClass().getName(mPtr)) + ": el ragdoll se deshizo");
+            mLiveRagdoll = false;
+            return;
+        }
+        // An animation a mod started meanwhile (a stagger, say) would take the bones back.
+        if (mAnimation->hasActiveAnimations())
+            mAnimation->stopAllAnimations();
+        for (const auto& [bone, matrix] : poses)
+            if (!bone.empty())
+                mAnimation->setBoneWorldMatrix(bone, matrix);
+        stats.setKnockedDown(true);
+        world->setActorCollisionMode(mPtr, true, false);
+
+        mLiveRagdollTime += duration;
+        const osg::Vec3f main = poses.front().second.getTrans();
+        const float speed = duration > 0 ? (main - mLiveRagdollLast).length() / duration : 0.f;
+        mLiveRagdollLast = main;
+        if (speed < 25.f)
+            mLiveRagdollRest += duration;
+        else
+            mLiveRagdollRest = 0;
+
+        const bool knockout = stats.getFatigue().getCurrent() < 0 || stats.getFatigue().getBase() == 0;
+        const float getUpTime = deliriumConfig().mGetUpTime;
+        if (!knockout
+            && ((mLiveRagdollRest > 0.4f && mLiveRagdollTime > getUpTime) || mLiveRagdollTime > getUpTime + 4.f))
+            getUpFromRagdoll(poses);
+    }
+
+    void CharacterController::getUpFromRagdoll(const std::vector<std::pair<std::string, osg::Matrixf>>& poses)
+    {
+        MWBase::World* world = MWBase::Environment::get().getWorld();
+        world->removeRagdoll(mPtr);
+        mLiveRagdoll = false;
+        world->setActorCollisionMode(mPtr, true, true);
+        deliriumEvent(std::string(mPtr.getClass().getName(mPtr)) + ": se levanta");
+
+        // Where it lies, on the ground, facing the way its head points: Morrowind gets up from lying face down
+        // (the end of "knockout"; "knockdown" only goes down on one knee). On its back, the blend rolls it over.
+        const osg::Vec3f pelvis = poses.front().second.getTrans();
+        osg::Vec3f toHead;
+        bool faceUp = false;
+        for (const auto& [bone, matrix] : poses)
+        {
+            if (Misc::StringUtils::ciEqual(bone, "Bip01 Head"))
+                toHead = matrix.getTrans() - pelvis;
+            // The spine's bones have their Z across the body, pointing out of the chest... for Morrowind's
+            // skeleton it is Y that points forward out of the chest.
+            if (Misc::StringUtils::ciEqual(bone, "Bip01 Spine1"))
+                faceUp = (osg::Matrixf::transform3x3(osg::Vec3f(0, 1, 0), matrix)).z() > 0.2f;
+        }
+        toHead.z() = 0;
+        const osg::Vec3f position = mPtr.getRefData().getPosition().asVec3();
+        world->moveObject(mPtr, osg::Vec3f(pelvis.x(), pelvis.y(), std::max(position.z(), pelvis.z() - 30.f)));
+        if (toHead.normalize() > 0)
+        {
+            const ESM::Position& pos = mPtr.getRefData().getPosition();
+            world->rotateObject(mPtr, osg::Vec3f(pos.rot[0], pos.rot[1], std::atan2(toHead.x(), toHead.y())));
+        }
+        mPtr.getClass().adjustPosition(mPtr, false);
+
+        CreatureStats& stats = mPtr.getClass().getCreatureStats(mPtr);
+        stats.setKnockedDown(true);
+        mHitState = CharState_KnockDown;
+        const float* tune = deliriumConfig().mTune;
+        float startPoint = tune[24];
+        mCurrentHit = "knockout";
+        if (!mAnimation->hasAnimation(mCurrentHit))
+        {
+            mCurrentHit = "knockdown";
+            startPoint = 0.55f;
+        }
+        // (No loops: "knockout" would lie there for ever, between its loop keys.)
+        playBlendedAnimation(mCurrentHit, Priority_Knockdown, MWRender::BlendMask_All, true, 1, "start", "stop",
+            startPoint, 0);
+        mAnimation->blendFromPose(poses, faceUp ? tune[26] : tune[25]);
+    }
+
+    void CharacterController::updateFlinch(float duration)
+    {
+        if (!mFlinching)
+            return;
+        // A spring, a little under-damped: it gives, comes back past straight a bit, and settles.
+        const float* tune = deliriumConfig().mTune;
+        const float stiffness = tune[13];
+        const float damping = tune[14];
+        const float maxAngle = tune[17];
+        float left = std::min(duration, 0.1f);
+        while (left > 0)
+        {
+            const float dt = std::min(left, 1.f / 60.f);
+            left -= dt;
+            mFlinchSpeed += (mFlinchAngle * -stiffness - mFlinchSpeed * damping) * dt;
+            mFlinchAngle += mFlinchSpeed * dt;
+            if (mFlinchAngle.length() > maxAngle)
+                mFlinchAngle *= maxAngle / mFlinchAngle.length();
+        }
+        const float angle = mFlinchAngle.length();
+        if (angle < 0.002f && mFlinchSpeed.length() < 0.02f)
+        {
+            mFlinchAngle = mFlinchSpeed = osg::Vec2f();
+            mFlinching = false;
+            mAnimation->setFlinch(osg::Quat());
+            return;
+        }
+        // The top of the body goes the way the blow pushes it: turning about up x that way.
+        const osg::Vec3f axis(-mFlinchAngle.y() / angle, mFlinchAngle.x() / angle, 0.f);
+        mAnimation->setFlinch(osg::Quat(angle, axis), tune[18], tune[19], tune[20], tune[21]);
+    }
+
+    void CharacterController::driveRagdoll()
+    {
+        if (mDelirium != nullptr)
+        {
+            // Dying in Delirium; once it lies still its body is an ordinary (sleeping) ragdoll, to be dragged about.
+            mDelirium->step(mDeliriumDuration);
+            const bool broken = mDelirium->isBroken();
+            if (!broken)
+            {
+                std::vector<std::pair<std::string, osg::Matrixf>> poses = writeDeliriumBones();
+                mPtr.getClass().getCreatureStats(mPtr).setRagdollPose(std::move(poses));
+            }
+            if (broken || (mDelirium->isDown() && mDelirium->getStillTime() > 1.2f && mDelirium->getAge() > 3.f)
+                || mDelirium->getAge() > 10.f)
+            {
+                {
+            mDelirium.reset();
+            if (mAnimation != nullptr)
+                mAnimation->setPoseLocked(false, !mPtr.getClass().getCreatureStats(mPtr).isDead());
+        }
+                MWBase::Environment::get().getWorld()->makeRagdoll(mPtr, osg::Vec3f(), false, !broken);
+            }
+            return;
+        }
+        const std::vector<std::pair<std::string, osg::Matrixf>> poses
+            = MWBase::Environment::get().getWorld()->getRagdollBonePoses(mPtr);
+        if (poses.empty())
+        {
+            // Gone while the body is still here (it came apart; see World::doPhysics): back to its death pose.
+            if (mRagdoll)
+            {
+                mRagdoll = false;
+                mCurrentDeath.clear();
+            }
+            return;
+        }
+        if (!mRagdoll)
+        {
+            // Made since it died (picking up a body from before a save): it takes over from the death pose.
+            mRagdoll = true;
+            mAnimation->stopAllAnimations();
+        }
+        // Parents first, so each bone is placed relative to where its parent now is.
+        // (A body in one piece, unnamed, moves the actor itself; see PhysicsSystem::moveActors.)
+        for (const auto& [bone, world] : poses)
+            if (!bone.empty())
+                mAnimation->setBoneWorldMatrix(bone, world);
+
+        // Remembered (and saved) where it lies. (Not relative to the actor: a corpse settles onto the ground when
+        // it is loaded, which would bury the body.)
+        std::vector<std::pair<std::string, osg::Matrixf>> pose(poses.begin(), poses.end());
+        mPtr.getClass().getCreatureStats(mPtr).setRagdollPose(std::move(pose));
+    }
+
+    void CharacterController::restoreRagdoll()
+    {
+        const std::vector<std::pair<std::string, osg::Matrixf>>& pose
+            = mPtr.getClass().getCreatureStats(mPtr).getRagdollPose();
+        if (pose.empty() || mPtr == getPlayer())
+            return;
+        // Moved away since (by a script, say): it lies as it died there.
+        constexpr float maxDistance = 256.f;
+        if ((pose.front().second.getTrans() - mPtr.getRefData().getPosition().asVec3()).length2()
+            > maxDistance * maxDistance)
+            return;
+
+        // Pose the body as it lay, then make the ragdoll from that pose, at rest.
+        mAnimation->stopAllAnimations();
+        for (const auto& [bone, world] : pose)
+        {
+            if (!bone.empty())
+                mAnimation->setBoneWorldMatrix(bone, world);
+            else if (SceneUtil::PositionAttitudeTransform* base = mPtr.getRefData().getBaseNode())
+            {
+                // In one piece: the whole model.
+                osg::Vec3f translation;
+                osg::Quat rotation;
+                osg::Vec3f scale;
+                osg::Quat scaleOrientation;
+                world.decompose(translation, rotation, scale, scaleOrientation);
+                base->setPosition(translation);
+                base->setAttitude(rotation);
+            }
+        }
+        if (!MWBase::Environment::get().getWorld()->makeRagdoll(mPtr, osg::Vec3f(), true, true))
+            return; // It plays its death animation after all.
+        mRagdoll = true;
+        // Not the death animation, which it already played.
+        if (mDeathState != CharState_None)
+            mCurrentDeath = deathStateToAnimGroup(mDeathState);
+    }
