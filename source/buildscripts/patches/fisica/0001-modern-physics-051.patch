+    bool CharacterController::canUseDeliriumBody() const
+    {
+        // People (its body is a person's, made for their skeleton). The rest keep the simpler reactions.
+        return mAnimation != nullptr && mPtr != getPlayer() && mPtr.getClass().isNpc() && DeliriumBody::available()
+            && mAnimation->getBoneWorldMatrix("Bip01 Spine2").has_value();
+    }
+
+    bool CharacterController::startDeliriumBody(bool dying)
+    {
+        MWBase::World* world = MWBase::Environment::get().getWorld();
+        SceneUtil::PositionAttitudeTransform* base = mPtr.getRefData().getBaseNode();
+        if (base == nullptr || mAnimation == nullptr)
+            return false;
+        osg::Matrix baseWorld;
+        base->computeLocalToWorldMatrix(baseWorld, nullptr);
+        const osg::Matrixf baseMatrix(baseWorld);
+        bool isBeast = false;
+        if (mPtr.getClass().isNpc())
+        {
+            const ESM::NPC* npc = mPtr.get<ESM::NPC>()->mBase;
+            const ESM::Race* race = world->getStore().get<ESM::Race>().find(npc->mRace);
+            isBeast = (race->mData.mFlags & ESM::Race::Beast) != 0;
+        }
+        const ESM::Position& position = mPtr.getRefData().getPosition();
+        mDelirium = DeliriumBody::create(
+            [this](std::string_view bone) { return mAnimation->getBoneWorldMatrix(bone); }, baseMatrix,
+            position.asVec3(), position.rot[2], isBeast, dying);
+        if (mDelirium == nullptr)
+            return false;
+        mDeliriumWorldTimer = 0;
+        gatherDeliriumWorld();
+        mAnimation->cancelPoseBlend();
+        mAnimation->stopAllAnimations();
+        mAnimation->setPoseLocked(true);
+        // As for a knockdown: whatever it was doing ends.
+        CreatureStats& stats = mPtr.getClass().getCreatureStats(mPtr);
+        stats.setHitRecovery(false);
+        if (!dying)
+        {
+            if (!mCurrentWeapon.empty())
+                mAnimation->disable(mCurrentWeapon);
+            if (mUpperBodyState > UpperBodyState::WeaponEquipped)
+            {
+                mUpperBodyState = UpperBodyState::WeaponEquipped;
+                if (mWeaponType > ESM::Weapon::None)
+                    mAnimation->showWeapons(true);
+            }
+            else if (mUpperBodyState < UpperBodyState::WeaponEquipped)
+                mUpperBodyState = UpperBodyState::None;
+            mHitState = CharState_None;
+            mCurrentHit.clear();
+            resetCurrentMovementState();
+            resetCurrentIdleState();
+            resetCurrentJumpState();
+            mAnimation->stopAllAnimations();
+        }
+        mFlinchAngle = mFlinchSpeed = osg::Vec2f();
+        mFlinching = false;
+        mAnimation->setFlinch(osg::Quat());
+        return true;
+    }
