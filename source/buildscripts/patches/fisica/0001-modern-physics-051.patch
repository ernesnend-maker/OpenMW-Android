+    void CharacterController::gatherDeliriumWorld()
+    {
+        // What is around it (ground, walls, stairs, furniture), for its own little world.
+        MWBase::World* world = MWBase::Environment::get().getWorld();
+        const osg::Vec3f center = mDelirium->getPelvisPosition();
+        mLiveRagdollLast = center;
+        const std::vector<osg::Vec3f> triangles = world->getStaticTriangles(center, 450.f, 300.f);
+        if (std::getenv("FISICA_NOMESH") == nullptr)
+            mDelirium->setWorld(triangles);
+        if (deliriumConfig().mDebug)
+            Log(Debug::Info) << "Delirium: world of " << triangles.size() / 3 << " triangles";
+    }
+
+    std::vector<std::pair<std::string, osg::Matrixf>> CharacterController::writeDeliriumBones()
+    {
+        MWBase::World* world = MWBase::Environment::get().getWorld();
+        // The actor goes where its body goes (under the pelvis); the bones are then put where the parts are.
+        const osg::Vec3f pelvis = mDelirium->getPelvisPosition();
+        const osg::Vec3f position = mPtr.getRefData().getPosition().asVec3();
+        if ((osg::Vec2f(pelvis.x(), pelvis.y()) - osg::Vec2f(position.x(), position.y())).length2() > 4.f)
+            world->moveObject(mPtr, osg::Vec3f(pelvis.x(), pelvis.y(), position.z()));
+        std::vector<std::pair<std::string, osg::Matrixf>> poses = mDelirium->getBonePoses();
+        for (const auto& [bone, matrix] : poses)
+            mAnimation->setBoneWorldMatrix(bone, matrix);
+        // Far from where its world was gathered: a new one around it.
+        if ((pelvis - mLiveRagdollLast).length2() > 180.f * 180.f)
+            gatherDeliriumWorld();
+        return poses;
+    }
