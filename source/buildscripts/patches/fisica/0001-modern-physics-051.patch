+    void Animation::blendFromPose(
+        const std::vector<std::pair<std::string, osg::Matrixf>>& worldPoses, float seconds)
+    {
+        cancelPoseBlend();
+        if (seconds <= 0 || worldPoses.empty())
+            return;
+        // The bones as the body left them, where the actor is now; then what each keeps of it (see the controller).
+        mPoseBlendPoses.clear();
+        for (const auto& [bone, world] : worldPoses)
+        {
+            const auto found = getNodeMap().find(bone);
+            if (found == getNodeMap().end())
+                continue;
+            setBoneWorldMatrix(bone, world);
+            if (!mPoseBlendPoses.empty())
+            {
+                mPoseBlendPoses.emplace_back(bone, osg::Matrixf(found->second->getMatrix()));
+                continue;
+            }
+            osg::NodePathList paths = found->second->getParentalNodePaths();
+            if (paths.empty())
+                return;
+            osg::NodePath& path = paths.front();
+            const auto base = std::find(path.begin(), path.end(), mInsert.get());
+            if (base == path.end())
+                return;
+            mPoseBlendPoses.emplace_back(bone, osg::Matrixf(osg::computeLocalToWorld(osg::NodePath(base + 1, path.end()))));
+        }
+        osg::ref_ptr<PoseBlendState> state = new PoseBlendState;
+        state->mWeight = 1;
+        mPoseBlend = state;
+        mPoseBlendTime = seconds;
+        mPoseBlendLeft = seconds;
+        addPoseBlendControllers();
+    }
+
+    void Animation::cancelPoseBlend()
+    {
+        if (mPoseBlend != nullptr)
+            static_cast<PoseBlendState*>(mPoseBlend.get())->mWeight = 0;
