+# Impact sounds for "Morrowind - Modern Physics": Morrowind's own sounds, played where things hit.
+#
+# Distances are in game units (about 70 to a meter), speeds in units per second, times in seconds.
+# Switches for each kind of impact sound are in settings.cfg, [Modern Physics]. With
+#   impact sound debug = true
+# there, every impact is written to openmw.log, and changes to this file are used as soon as it is saved.
+
+limits:
+  # How hard a contact must be to make a sound at all: the change of speed it caused. Below this it is
+  # resting, rolling, sliding or jitter.
+  min speed: 80
+  # The change of speed at which a sound is at full volume (quieter in between).
+  loud speed: 700
+  # How soon the same object can make another impact sound.
+  object cooldown: 0.15
+  # At most this many impact sounds may start within "max sounds window" seconds; more are skipped.
+  max sounds: 6
+  max sounds window: 0.4
+  # How far impact sounds carry: full volume within this distance, fading beyond it (half volume at
+  # twice the distance, and so on), and silent past "heard up to". (Morrowind's own sounds mostly use
+  # 100 and 2000, which is too quiet for something hitting a wall across the room.)
+  full volume within: 500
+  heard up to: 4000
+  # The softest impact that still makes a sound plays at this share of its volume; the hardest at full.
+  quietest: 0.6
+
+# How a sound is given (here and below):
+#   sound:  a sound record, or a list of them   (e.g. "Hand to Hand Hit 2"; try one with PlaySound "..." in the console)
+#   file:   a file in Data Files/Sound, or a list (e.g. "Fx/LEFTWOD1.wav", one of Morrowind's unused sounds)
+#   volume: 0 to 1, or [lowest, highest]; it is also scaled by how hard the impact was
+#   pitch:  1 is normal, or [lowest, highest]; each time a value in between is picked
+# With several sounds and files, one of them is picked each time.
+# Materials: wood, stone, ceramic (pottery, glass), metal, earth (dirt, plants), cloth (also leather, paper),
+# flesh (bodies), and default (anything not listed).
+
+# Arrows, bolts and thrown weapons hitting the world (not people, items or water).
+projectiles:
+  # Flying this fast (or faster) is full volume.
+  loud speed: 2500
+  # Stuck in what was hit: a thunk.
+  stick:
+    wood:    { file: "Fx/LEFTWOD1.wav", sound: "Hand to Hand Hit 2", volume: [0.8, 1.0], pitch: [1.1, 1.3] }
+    earth:   { sound: "Body Fall Small", volume: [0.8, 1.0], pitch: [1.3, 1.5] }
+    cloth:   { sound: "Hand To Hand Hit", volume: [0.7, 0.9], pitch: [1.2, 1.4] }
+    default: { sound: "Hand to Hand Hit 2", volume: [0.7, 0.9], pitch: [1.1, 1.3] }
+  # Glancing off: a clatter, or a clang off metal.
+  glance:
+    metal:   { sound: ["Light Armor Hit", "Medium Armor Hit"], volume: [0.6, 0.8], pitch: [1.1, 1.3] }
+    stone:   { sound: "Item Ammo Down", volume: [0.8, 1.0], pitch: [0.9, 1.1] }
+    ceramic: { sound: "Item Ammo Down", volume: [0.7, 0.9], pitch: [1.1, 1.3] }
+    wood:    { file: "Fx/LEFTWOD1.wav", volume: [0.7, 0.9], pitch: [1.0, 1.2] }
+    default: { sound: "Item Ammo Down", volume: [0.8, 1.0], pitch: [0.9, 1.1] }
+
+# Items and bodies (ragdolls) hitting the world: landing, falling off shelves, being thrown or knocked.
+objects:
+  # Hitting this hard (change of speed) or harder is full volume. ("min speed" above is the softest.)
+  loud speed: 600
+  # Items sound by what they are made of. These are short, sharp sounds from Morrowind's files (several
+  # of them unused footsteps and door knocks); one is picked each time, for variety.
+  items:
+    wood:    { file: ["Fx/LEFTWOD1.wav", "Fx/LEFTWOD2.wav", "Fx/punch 2.wav"], volume: [0.8, 1.0], pitch: [0.9, 1.1] }
+    metal:   { file: ["Fx/item/blunt.wav", "Fx/Light Armor Hit.wav", "Fx/Medium Armor Hit.wav"], volume: [0.5, 0.7], pitch: [0.9, 1.1] }
+    ceramic: { file: ["Fx/LEFTWK1.wav", "Fx/LEFTWK2.wav", "Fx/RIGHTWK1.wav", "Fx/RIGHTWK2.wav"], volume: [0.7, 0.9], pitch: [0.9, 1.1] }
+    stone:   { file: ["Fx/trans/drstn_lokd.wav", "Fx/item/blunt.wav"], volume: [0.8, 1.0], pitch: [0.8, 1.0] }
+    cloth:   { file: ["Fx/punch 1.wav", "Fx/bodyfallSML.wav"], volume: [0.5, 0.7], pitch: [0.8, 1.0] }
+    earth:   { file: ["Fx/bodyfallSML.wav", "Fx/FOOT/land_lt.wav"], volume: [0.6, 0.8], pitch: [0.9, 1.1] }
+    default: { file: ["Fx/punch 2.wav", "Fx/item/blunt.wav", "Fx/FOOT/walkl_hv.wav"], volume: [0.7, 0.9], pitch: [0.9, 1.1] }
+  # Heavier things sound deeper, lighter ones higher: the pitch is multiplied by
+  # (normal at / weight) ^ amount, kept within the limits. (Weights: a bottle is about 1, a sword 5.)
+  pitch by weight:
+    normal at: 2
+    amount: 0.15
+    limits: [0.75, 1.3]
+  # Landing on something soft is quieter and duller: these multiply the volume and pitch above.
+  landing on:
+    earth: { volume: 0.7, pitch: 0.85 }
+    cloth: { volume: 0.6, pitch: 0.9 }
+  # Two items (or an item and a body) hitting each other: the harder one's sound is played (metal, then
+  # ceramic, stone, wood, cloth and earth), at this share of its volume.
+  each other: { volume: 0.8 }
+  # An item hit by an arrow or a melee swing: the harder of the item and the weapon is heard (a sword on a
+  # pot clanks, an arrow into a book knocks like wood), at this share of its volume, louder for a
+  # fuller swing or draw.
+  struck: { volume: 1.0 }
+  # Bodies: each part of a ragdoll hitting the ground or a wall. Soft below "medium speed", hard from
+  # "hard speed". One body makes a sound at most every "cooldown" seconds.
+  bodies:
+    cooldown: 0.35
+    medium speed: 250
+    hard speed: 500
+    soft:   { sound: "Body Fall Small", volume: [0.6, 0.8], pitch: [0.9, 1.1] }
+    medium: { sound: "Body Fall Medium", volume: [0.8, 1.0], pitch: [0.9, 1.1] }
+    hard:   { sound: "Body Fall Large", volume: [0.9, 1.0], pitch: [0.9, 1.0] }
+
+# Melee swings that hit no one and knock nothing loose, but meet a wall, the ground or furniture within
+# the weapon's reach. Sound only. By the weapon (blade, axe, blunt, spear, fist) and what it meets.
+# Volume follows how full the swing was. A material that isn't listed (and no default) is silent.
+melee:
+  blade:
+    metal:   { file: ["Fx/Medium Armor Hit.wav", "Fx/Light Armor Hit.wav"], volume: [0.7, 0.9], pitch: [1.0, 1.2] }
+    stone:   { file: ["Fx/Medium Armor Hit.wav", "Fx/Heavy Armor Hit.wav"], volume: [0.6, 0.8], pitch: [1.0, 1.15] }
+    ceramic: { file: ["Fx/Light Armor Hit.wav", "Fx/LEFTWK1.wav"], volume: [0.6, 0.8], pitch: [1.1, 1.3] }
+    wood:    { file: ["Fx/LEFTWOD1.wav", "Fx/LEFTWOD2.wav", "Fx/punch 2.wav"], volume: [0.8, 1.0], pitch: [1.0, 1.2] }
+    earth:   { file: ["Fx/bodyfallSML.wav", "Fx/FOOT/land_lt.wav"], volume: [0.6, 0.8], pitch: [1.1, 1.3] }
+    cloth:   { file: "Fx/punch 1.wav", volume: [0.4, 0.6], pitch: [1.0, 1.2] }
+    default: { file: ["Fx/Medium Armor Hit.wav", "Fx/item/blunt.wav"], volume: [0.6, 0.8], pitch: [1.0, 1.15] }
+  axe:
+    metal:   { file: ["Fx/Heavy Armor Hit.wav", "Fx/Medium Armor Hit.wav"], volume: [0.8, 1.0], pitch: [0.9, 1.05] }
+    stone:   { file: ["Fx/Heavy Armor Hit.wav", "Fx/item/blunt.wav"], volume: [0.7, 0.9], pitch: [0.9, 1.0] }
+    ceramic: { file: ["Fx/Medium Armor Hit.wav", "Fx/LEFTWK2.wav"], volume: [0.6, 0.8], pitch: [1.0, 1.2] }
+    wood:    { file: ["Fx/LEFTWOD1.wav", "Fx/LEFTWOD2.wav", "Fx/punch 2.wav"], volume: [0.9, 1.0], pitch: [0.85, 1.0] }
+    earth:   { file: ["Fx/bodyfallSML.wav", "Fx/FOOT/land_lt.wav"], volume: [0.7, 0.9], pitch: [0.9, 1.1] }
+    cloth:   { file: "Fx/punch 1.wav", volume: [0.5, 0.7], pitch: [0.9, 1.1] }
+    default: { file: ["Fx/Heavy Armor Hit.wav", "Fx/item/blunt.wav"], volume: [0.7, 0.9], pitch: [0.9, 1.0] }
+  blunt:
+    metal:   { file: ["Fx/Heavy Armor Hit.wav", "Fx/item/blunt.wav"], volume: [0.8, 1.0], pitch: [0.75, 0.9] }
+    stone:   { file: ["Fx/item/blunt.wav", "Fx/trans/drstn_lokd.wav"], volume: [0.8, 1.0], pitch: [0.8, 0.95] }
+    ceramic: { file: ["Fx/item/blunt.wav", "Fx/LEFTWK1.wav"], volume: [0.7, 0.9], pitch: [0.9, 1.1] }
+    wood:    { file: ["Fx/LEFTWOD1.wav", "Fx/LEFTWOD2.wav", "Fx/punch 2.wav"], volume: [0.9, 1.0], pitch: [0.75, 0.9] }
+    earth:   { file: ["Fx/bodyfallSML.wav", "Fx/FOOT/land_hv.wav"], volume: [0.7, 0.9], pitch: [0.8, 1.0] }
+    cloth:   { file: ["Fx/punch 1.wav", "Fx/bodyfallSML.wav"], volume: [0.5, 0.7], pitch: [0.8, 1.0] }
+    default: { file: ["Fx/item/blunt.wav", "Fx/Heavy Armor Hit.wav"], volume: [0.8, 1.0], pitch: [0.8, 0.95] }
+  spear:
+    metal:   { file: ["Fx/Light Armor Hit.wav", "Fx/Medium Armor Hit.wav"], volume: [0.6, 0.8], pitch: [1.1, 1.3] }
+    stone:   { file: ["Fx/Medium Armor Hit.wav", "Fx/item/blunt.wav"], volume: [0.5, 0.7], pitch: [1.05, 1.2] }
+    ceramic: { file: ["Fx/LEFTWK1.wav", "Fx/LEFTWK2.wav"], volume: [0.6, 0.8], pitch: [1.0, 1.2] }
+    wood:    { file: ["Fx/LEFTWOD1.wav", "Fx/LEFTWOD2.wav"], volume: [0.8, 1.0], pitch: [1.0, 1.2] }
+    earth:   { file: "Fx/bodyfallSML.wav", volume: [0.5, 0.7], pitch: [1.2, 1.4] }
+    cloth:   { file: "Fx/punch 1.wav", volume: [0.4, 0.6], pitch: [1.1, 1.3] }
+    default: { file: ["Fx/Medium Armor Hit.wav", "Fx/item/blunt.wav"], volume: [0.5, 0.7], pitch: [1.05, 1.2] }
+  # Fists: a dull thud on wood, earth and cloth; nothing on stone, metal or ceramic.
+  fist:
+    wood:    { file: ["Fx/punch 1.wav", "Fx/punch 2.wav"], volume: [0.4, 0.6], pitch: [0.9, 1.1] }
+    earth:   { file: ["Fx/punch 1.wav", "Fx/bodyfallSML.wav"], volume: [0.3, 0.5], pitch: [0.9, 1.1] }
+    cloth:   { file: "Fx/punch 1.wav", volume: [0.3, 0.5], pitch: [0.9, 1.1] }
+
+# Splashes when things fall into water: items (always), and dead bodies and projectiles ("extended water
+# splashes" in settings.cfg). Nothing hitting the bottom under water is heard: just the splash. Bigger is deeper: the pitch follows (normal at / size) ^ 0.15, where
+# a body's size is about its length (a person or a big rat about 150) and an item's or a projectile's is its
+# weight.
+# Slower than "min speed" makes no splash; "loud speed" or faster is full volume.
+water:
+  items:
+    sound: "DefaultLandWater"
+    file: ["Fx/FOOT/splsh2.wav", "Fx/FOOT/splsh3.wav"]
+    volume: [0.5, 0.7]
+    pitch: [1.1, 1.3]
+    min speed: 40
+    loud speed: 600
+    # Weight at normal pitch: lighter splashes higher, heavier deeper.
+    normal at: 2
+    cooldown: 1
+  bodies:
+    sound: "DefaultLandWater"
+    file: ["Fx/FOOT/splsh2.wav", "Fx/FOOT/splsh3.wav"]
+    volume: [0.9, 1.0]
+    pitch: [0.8, 0.95]
+    min speed: 100
+    loud speed: 500
+    normal at: 120
+    # One body splashes at most this often (a floating one bobs through the surface).
+    cooldown: 2
+  projectiles:
+    file: ["Fx/FOOT/splsh2.wav", "Fx/FOOT/splsh3.wav"]
+    volume: [0.4, 0.6]
+    pitch: [1.3, 1.6]
+    min speed: 200
+    loud speed: 3000
+    normal at: 0.1
