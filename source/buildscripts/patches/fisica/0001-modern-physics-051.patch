diff --git a/apps/openmw/mwmechanics/delirium.hpp b/apps/openmw/mwmechanics/delirium.hpp
new file mode 100644
index 000000000..b02d72744
--- /dev/null
+++ b/apps/openmw/mwmechanics/delirium.hpp
@@ -0,0 +1,126 @@
+#ifndef OPENMW_MWMECHANICS_DELIRIUM_H
+#define OPENMW_MWMECHANICS_DELIRIUM_H
+
+#include <deque>
+#include <string>
+
+#include <osg/Vec3f>
+
+namespace MWMechanics
+{
+    // Fisica (0.51 Android): "Delirium", physical hit reactions for NPCs and creatures (after Skyrim Delirium).
+    // Light hits bend the body away from the blow (a spring on the spine and neck); hard ones (and knockdowns)
+    // throw it into a ragdoll with muscles that fade, which gets up again with the knockdown animation.
+    // Set from Lua (world.setDelirium); off by default, so the engine behaves as before.
+    struct DeliriumConfig
+    {
+        bool mEnabled = false;
+        float mIntensity = 1.f; // how far light hits bend the body
+        float mFallThreshold = 0.25f; // a hit taking this part of the max health throws it down
+        bool mCreatures = true; // creatures too (not only NPCs)
+        bool mReplaceHits = true; // light hits: no hit animation, only the bend
+        bool mKnockdowns = true; // the engine's knockdowns (and knockouts) are falls too
+        float mGetUpTime = 1.5f; // seconds lying down before getting up
+        bool mReal = true; // the real Delirium engine, where it is built in and the skeleton is a person's
+        float mPush = 1.f; // how hard blows push (the real engine): the level of the reactions
+        // The push follows the attacker's strength and the damage all the way (off: the damage only, and tamely).
+        bool mByStrength = false;
+        // A vampire's or a werewolf's blows throw people about (theirs times mMonsterPower).
+        bool mMonsters = false;
+        float mMonsterPower = 3.f;
+        bool mDeaths = true; // deaths are Delirium's too (the real engine)
+        bool mMagic = true; // spells that hurt are blows too, and fire, lightning and frost have their own reactions
+        bool mGuard = false; // light hits: the flinch with the hands up (off: it only takes the blow and steps)
+        // "Precision": the blow lands where the swing goes (a chop from above on the head and shoulders, a slash
+        // across from the side, a thrust in the belly) and pushes that way; and both freeze for an instant.
+        bool mAimed = true;
+        float mHitStop = 0.07f; // seconds (0: none)
+        bool mDebug = false; // what it decides, for Lua to show (world.takeDeliriumEvents)
+        // Tuning (world.setDelirium{tune = {...}}, 1-based there). See the names below.
+        float mTune[32] = {
+            110.f, 420.f, 300.f, 25.f, // 0 kick: base, per strength, max, up
+            0.8f, 0.2f, 1.0f, // 4 spine muscles: tone, tone at the end, seconds
+            0.6f, 0.1f, 1.2f, // 7 arms
+            0.4f, 0.0f, 0.35f, // 10 legs
+            45.f, 5.f, 3.5f, 12.f, 0.7f, // 13 flinch: stiffness, damping, impulse base, impulse per strength, max angle
+            0.7f, 0.5f, 0.6f, // 18 flinch: how much of the angle the lower spine, the upper spine and the neck take
+            -0.6f, // 21 flinch: the upper arms (negative: left behind)
+            0.9f, 6.f, // 22 down: seconds until it holds on to the ground, and how hard
+            0.52f, 0.45f, 0.8f, // 24 getting up: where "knockout" starts, blend seconds face down, and face up
+            0.f, 0.f, 0.f, 0.f, 0.f,
+        };
+        std::deque<std::string> mEvents;
+    };
+
+    inline DeliriumConfig& deliriumConfig()
+    {
+        static DeliriumConfig config;
+        return config;
+    }
+
+    inline void deliriumEvent(std::string text)
+    {
+        DeliriumConfig& cfg = deliriumConfig();
+        if (!cfg.mDebug)
+            return;
+        cfg.mEvents.push_back(std::move(text));
+        while (cfg.mEvents.size() > 12)
+            cfg.mEvents.pop_front();
+    }
+
+    // How hard a live ragdoll's joints keep their pose, by group (0: limp), fading to the end value over seconds.
+    struct RagdollMuscles
+    {
+        enum Group { Spine, Arms, Legs, Groups };
+        float mTone[Groups] = { 0, 0, 0 };
+        float mToneEnd[Groups] = { 0, 0, 0 };
+        float mSeconds[Groups] = { 0, 0, 0 };
+        float mBrakeAfter = 0; // seconds until it starts to hold on to the ground (0: never)
+        float mBrakeRate = 0; // how hard (per second)
+    };
+
+    // The last hit, until the character controller takes it.
+    struct DeliriumHit
+    {
+        osg::Vec3f mAway; // horizontal, away from the attacker (unit), or zero
+        osg::Vec3f mPoint; // where it hit, or zero
+        osg::Vec3f mPush; // the way the blow goes (unit, with its up or down), or zero: away
+        float mStrength = 0; // health taken / max health
+        float mAttackerStrength = 50; // the attacker's Strength attribute
+        int mElement = 0; // a spell's: 1 fire, 2 lightning, 3 frost (0: none)
+        bool mMagic = false; // a spell did it
+        bool mAttackerMonster = false; // a vampire or a werewolf did it (in melee)
+        bool mPending = false;
+    };
+
+    // Where a melee swing lands and which way it pushes. type: ESM::Weapon::AT_* (0 chop, 1 slash, 2 thrust).
+    inline void deliriumAim(DeliriumHit& hit, int type, const osg::Vec3f& victim, float victimHeight,
+        const osg::Vec3f& attacker, bool leftToRight)
+    {
+        if (!deliriumConfig().mAimed || hit.mAway.length2() < 0.01f)
+            return;
+        const osg::Vec3f forward = hit.mAway;
+        const osg::Vec3f left(-forward.y(), forward.x(), 0.f);
+        const float side = leftToRight ? -1.f : 1.f;
+        const float h = victimHeight > 1.f ? victimHeight : 128.f;
+        switch (type)
+        {
+            case 0: // down on the head and shoulders
+                hit.mPush = forward * 0.55f + osg::Vec3f(0, 0, -0.8f) + left * (0.15f * side);
+                hit.mPoint = victim - forward * 8.f + osg::Vec3f(0, 0, h * 0.95f);
+                break;
+            case 1: // across, from the attacker's right to its left
+                hit.mPush = forward * 0.45f + left * (0.9f * side);
+                hit.mPoint = victim - left * (14.f * side) - forward * 6.f + osg::Vec3f(0, 0, h * 0.72f);
+                break;
+            default: // straight in
+                hit.mPush = forward;
+                hit.mPoint = victim - forward * 10.f + osg::Vec3f(0, 0, h * 0.6f);
+                break;
+        }
+        hit.mPush.normalize();
+        (void)attacker;
+    }
+}
+
+#endif
