+    bool CharacterController::startLiveRagdoll(const osg::Vec3f& kick)
+    {
+        MWBase::World* world = MWBase::Environment::get().getWorld();
+        // Muscles: it braces a moment, then gives (it doesn't fall like a sack, nor stay stiff).
+        const float* tune = deliriumConfig().mTune;
+        RagdollMuscles muscles;
+        for (int g = 0; g < RagdollMuscles::Groups; ++g)
+        {
+            muscles.mTone[g] = tune[4 + g * 3];
+            muscles.mToneEnd[g] = tune[5 + g * 3];
+            muscles.mSeconds[g] = tune[6 + g * 3];
+        }
+        muscles.mBrakeAfter = tune[22];
+        muscles.mBrakeRate = tune[23];
+        if (!world->makeLiveRagdoll(mPtr, kick, muscles))
+            return false;
+        mLiveRagdoll = true;
+        mLiveRagdollTime = 0;
+        mLiveRagdollRest = 0;
+        mLiveRagdollLast = mPtr.getRefData().getPosition().asVec3();
+        CreatureStats& stats = mPtr.getClass().getCreatureStats(mPtr);
+        stats.setKnockedDown(true);
+        stats.setHitRecovery(false);
+        // As for a knockdown: no weapon swing on the way down.
+        if (!mCurrentWeapon.empty())
+            mAnimation->disable(mCurrentWeapon);
+        if (mUpperBodyState > UpperBodyState::WeaponEquipped)
+        {
+            mUpperBodyState = UpperBodyState::WeaponEquipped;
+            if (mWeaponType > ESM::Weapon::None)
+                mAnimation->showWeapons(true);
+        }
+        else if (mUpperBodyState < UpperBodyState::WeaponEquipped)
+            mUpperBodyState = UpperBodyState::None;
+        mHitState = CharState_None;
+        mCurrentHit.clear();
+        resetCurrentMovementState();
+        resetCurrentIdleState();
+        resetCurrentJumpState();
+        mAnimation->stopAllAnimations();
+        mFlinchAngle = mFlinchSpeed = osg::Vec2f();
+        mFlinching = false;
+        mAnimation->setFlinch(osg::Quat());
+        world->setActorCollisionMode(mPtr, true, false);
+        return true;
+    }
