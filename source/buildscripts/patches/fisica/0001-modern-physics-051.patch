+    std::unique_ptr<DeliriumBody> DeliriumBody::create(
+        const BoneGetter& bone, const osg::Matrixf& base, const osg::Vec3f& position, float heading, bool beast,
+        bool dying)
+    {
+        if (!init())
+            return nullptr;
+        sRig = beast ? kRigBeast : kRig;
+        for (int i = 0; i < 21; ++i)
+            if (!bone(sRig[i].mBone) || !bone(sRig[i].mJointA) || !bone(sRig[i].mJointB))
+                return nullptr;
+
+        std::unique_ptr<DeliriumBody> body(new DeliriumBody);
+        body->mBeast = beast;
+        body->mOrigin = position;
+        // The actor is drawn at its race's size (not the same along every axis); the body is Delirium's own, at a
+        // person's. From one to the other: the actor's size, about where it stands, along its own axes.
+        {
+            osg::Vec3f translation, scale;
+            osg::Quat rotation, scaleOrientation;
+            base.decompose(translation, rotation, scale, scaleOrientation);
+            osg::Matrixf placed;
+            placed.makeRotate(rotation);
+            placed.setTrans(translation);
+            body->mSize = osg::Matrixf::inverse(placed) * base;
+            body->mSizeInverse = osg::Matrixf::inverse(body->mSize);
+        }
+
+        const float zero[3] = {};
+        const float yaw = std::atan2(std::cos(heading), std::sin(heading)) - (beast ? kRigYawBeast : kRigYaw);
+        body->mAgent = nm_agent_create(beast ? sBuildBeast : sBuild, zero, yaw, Misc::Rng::rollClosedProbability());
+        body->mWorld = nm_world_create();
+        if (body->mAgent == nullptr || body->mWorld == nullptr)
+        {
+            sError = "agent: " + engineError();
+            return nullptr;
+        }
+        nm_world_add_floor(body->mWorld, 0, 0, 0, 100.f);
+
+        // The body's own standing stance, each part in its parent's frame: the legs hold it while it stands.
+        {
+            std::array<V3, 21> rp;
+            std::array<Q, 21> rq;
+            for (int i = 0; i < 21; ++i)
+            {
+                float p[3] = {}, q[4] = { 0, 0, 0, 1 };
+                nm_agent_get_part_transform(body->mAgent, i, p, q);
+                rp[i] = { p[0], p[1], p[2] };
+                rq[i] = { q[0], q[1], q[2], q[3] };
+            }
+            for (int i = 1; i < 21; ++i)
+            {
+                const int p = sParent[i];
+                body->mRestRot[i] = M::mul(M::conj(rq[p]), rq[i]);
+                body->mRestPos[i] = M::rot(M::conj(rq[p]), M::sub(rp[i], rp[p]));
+            }
+        }
+
+        std::array<V3, 21> pos;
+        std::array<Q, 21> rot;
+        body->partsFromBones(bone, pos, rot);
+        nm_agent_set_mode(body->mAgent, NM_MODE_LEAD);
+        for (int i = 0; i < 21; ++i)
+        {
+            const float p[3] = { pos[i].x, pos[i].y, pos[i].z };
+            const float q[4] = { rot[i].x, rot[i].y, rot[i].z, rot[i].w };
+            if (!finite(p, 3) || !finite(q, 4))
+            {
+                sError = "the pose is not a number";
+                return nullptr;
+            }
+            nm_agent_set_part_state(body->mAgent, i, p, q, zero, zero);
+        }
+
+        // The posture the muscles and the balance hold: the pose it was in, but with the legs of the body's own
+        // stance, soles level (a lunging attack's legs held still would tip it over by themselves).
+        {
+            std::array<V3, 21> zp = pos;
+            std::array<Q, 21> zr = rot;
+            if (!dying)
+            {
+                for (int i = 1; i <= 6; ++i)
+                {
+                    const int p = sParent[i];
+                    zr[i] = M::mul(zr[p], body->mRestRot[i]);
+                    zp[i] = M::add(zp[p], M::rot(zr[p], body->mRestPos[i]));
+                }
+                for (int i : { 3, 6 })
+                {
+                    const V3 u = M::rot(zr[i], { 0, 1, 0 });
+                    const Q t{ u.y, -u.x, 0.f, 1.f + u.z };
+                    const float n = std::sqrt(t.x * t.x + t.y * t.y + t.z * t.z + t.w * t.w);
+                    if (n > 1e-4f)
+                        zr[i] = M::mul({ t.x / n, t.y / n, t.z / n, t.w / n }, zr[i]);
+                }
+            }
+            float transforms[21 * 7];
+            for (int i = 0; i < 21; ++i)
+            {
+                const float v[7] = { zp[i].x, zp[i].y, zp[i].z, zr[i].x, zr[i].y, zr[i].z, zr[i].w };
+                std::copy_n(v, 7, transforms + i * 7);
+            }
+            nm_agent_set_zero_pose(body->mAgent, transforms, 21);
+        }
+
+        // The bones it writes: where each sits in its parent bone, as the skeleton has them now (their lengths stay).
+        for (const WrittenBone& written : sWritten)
+        {
+            Bone entry{ written.mName, written.mPart, written.mParent, {} };
+            if (written.mParent >= 0)
+            {
+                const osg::Matrixf own = *bone(written.mName) * body->mSizeInverse;
+                const osg::Matrixf parent = *bone(sWritten[written.mParent].mName) * body->mSizeInverse;
+                const osg::Vec3f offset = own.getTrans() - parent.getTrans();
+                entry.mInParent
+                    = M::rot(M::conj(rotationOf(parent)), { offset.x() * sUnit, offset.y() * sUnit, offset.z() * sUnit });
+            }
+            body->mBones.push_back(std::move(entry));
+        }
+
+        if (!dying)
+            body->message("bodyBalance");
+        return body;
+    }
