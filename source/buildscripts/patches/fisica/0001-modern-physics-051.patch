 # Transparent depth postpass. Re-renders transparent objects with alpha-clipping forced with a fixed threshold.
 transparent postpass = true
+
+[Modern Physics]
+# Settings for the "Morrowind - Modern Physics" fork.
+
+# Arrows, bolts and thrown weapons that stay in a body are real: each one shown is one that can be
+# looted from it after it dies (and a living one can't shoot them back). Kept through saves.
+# When off, any hit shows a stuck projectile for a while, and stored ones go straight into the
+# inventory, as in the fork's v1.0.
+recoverable stuck projectiles = true
+
+# Impact sounds, made from Morrowind's own sounds, played where things hit. Which sounds, how loud and
+# when are set in resources/vfs/modernphysics/impactsounds.yaml.
+# All of them (when off, none of the ones below play).
+impact sounds = true
+
+# Arrows, bolts and thrown weapons hitting the world: a thunk where they stick, a clatter or clang
+# where they glance off.
+projectile impact sounds = true
+
+# Items and bodies (ragdolls) landing, falling, and knocking into the world and each other.
+object impact sounds = true
+
+# Melee swings that hit a wall, the ground or anything else in the world instead of someone.
+melee world impact sounds = true
+
+# Splashes for bodies and projectiles hitting water, as items already have, scaled by size and speed.
+extended water splashes = true
+
+# Log every impact to openmw.log (what hit what, the materials, the sound picked or why none was), and
+# pick up changes to impactsounds.yaml while the game runs.
+impact sound debug = false
